import("std/http") as http
import("std/json") as json
import("std/list") as list
import("std/str") as str

let response = http.get("https://api.github.com/search/repositories?q=language:python+stars:>1000&sort=stars&per_page=3")
let d = json.decode(response.body)
{ status: response.status, total: d.total_count, first_name: list.get(d.items, 0).full_name }
