import("std/list") as list
import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/tensor") as tensor
import("../packages/azim_trial/weights") as weights
import("../packages/azim_trial/train_step") as train

test "train step returns record" {
  let step = train.train_step(weights.W_U, "sky is blue", "accepted", 0.01) in
  type.of(step) == "record"
}

test "train step loss decreases" {
  let step = train.train_step(weights.W_U, "sky is blue", "accepted", 0.01) in
  step.loss_delta < 0.0
}

test "train step records loss before and after" {
  let step = train.train_step(weights.W_U, "sky is blue", "accepted", 0.01) in
  (step.loss_before > 0.0) && (step.loss_after > 0.0)
}

test "train step returns updated W_U" {
  let step = train.train_step(weights.W_U, "sky is blue", "accepted", 0.01) in
  list.len(step.updated_W_U.data) == list.len(weights.W_U.data)
}

test "train step receipt deterministic" {
  let a = train.train_step_with_receipt(weights.W_U, "sky is blue", "accepted", 0.01) in
  let b = train.train_step_with_receipt(weights.W_U, "sky is blue", "accepted", 0.01) in
  (a.receipt == b.receipt) && str.starts_with(a.receipt, "sha256:")
}

test "multi step reduces loss" {
  let examples = [
    { text: "sky is blue", label: "accepted" },
    { text: "sky is green", label: "rejected" }
  ] in
  let result = train.multi_step(weights.W_U, examples, 0.01, 3) in
  let first = list.get(result.history, 0) in
  let last = list.get(result.history, 2) in
  last.loss_after < first.loss_before
}
