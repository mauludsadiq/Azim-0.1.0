import("std/list") as list
import("std/math") as math
import("../packages/azim_trial/spsa_factored") as sf

test "matmul_AB produces correct shape" {
  let A = list.build(6, fn(i) { 1.0 }) in
  let B = list.build(8, fn(i) { 1.0 }) in
  let AB = sf.matmul_AB(A, 3, 2, B, 4) in
  list.len(AB) == 12
}

test "matmul_AB computes correct values for known small case" {
  let A = [1.0, 2.0, 3.0, 4.0] in
  let B = [1.0, 0.0, 0.0, 1.0] in
  let AB = sf.matmul_AB(A, 2, 2, B, 2) in
  math.abs(list.get(AB, 0) - 1.0) < 0.0001 &&
  math.abs(list.get(AB, 1) - 2.0) < 0.0001 &&
  math.abs(list.get(AB, 2) - 3.0) < 0.0001 &&
  math.abs(list.get(AB, 3) - 4.0) < 0.0001
}

test "W_from_factors adds base correctly" {
  let W_base = [0.0, 0.0, 0.0, 0.0] in
  let A = [1.0, 0.0, 0.0, 1.0] in
  let B = [2.0, 0.0, 0.0, 2.0] in
  let W = sf.W_from_factors(W_base, A, 2, 2, B, 2) in
  math.abs(list.get(W, 0) - 2.0) < 0.0001
}

test "factored_spsa_step has correct factored_dim" {
  let rows = 129 in
  let cols = 64 in
  let r = 4 in
  let W_base = list.build(rows * cols, fn(i) { 0.0 }) in
  let A = list.build(rows * r, fn(i) { 0.01 }) in
  let B = list.build(r * cols, fn(i) { 0.01 }) in
  let loss_fn = fn(W) { list.fold(W, 0.0, fn(acc, x) { acc + x * x }) } in
  let result = sf.factored_spsa_step(W_base, A, B, rows, cols, r, 0, 0.01, 0.05, loss_fn) in
  result.factored_dim == (rows * r + r * cols) &&
  result.full_dim == (rows * cols)
}

test "factored_spsa_step reduces loss on quadratic bowl" {
  let rows = 8 in
  let cols = 8 in
  let r = 2 in
  let W_base = list.build(rows * cols, fn(i) { 0.0 }) in
  let A = list.build(rows * r, fn(i) { 0.3 }) in
  let B = list.build(r * cols, fn(i) { 0.3 }) in
  let loss_fn = fn(W) { list.fold(W, 0.0, fn(acc, x) { acc + x * x }) } in
  let result = list.fold(list.range(0, 30),
    { A: A, B: B, step: 0 },
    fn(acc, i) {
      let r2 = sf.factored_spsa_step(W_base, acc.A, acc.B, rows, cols, r, acc.step, 0.01, 0.02, loss_fn) in
      { A: r2.A, B: r2.B, step: acc.step + 1 }
    }) in
  let final_W = sf.W_from_factors(W_base, result.A, rows, r, result.B, cols) in
  let final_loss = loss_fn(final_W) in
  let initial_W = sf.W_from_factors(W_base, A, rows, r, B, cols) in
  let initial_loss = loss_fn(initial_W) in
  final_loss < initial_loss * 0.5
}
