import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/tensor") as tensor
import("../packages/azim_trial/parameter_registry") as preg
import("../packages/azim_trial/module_graph") as mg
import("../packages/azim_trial/corpus") as corpus
import("../packages/azim_trial/training_manifest") as manifest

test "training manifest build returns record" {
  let t = tensor.vector([1.0, 2.0, 3.0]) in
  let p = preg.parameter("p0", t, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    corpus.example("sky is blue", "accepted", "p0"),
    corpus.example("sky is green", "rejected", "p0")
  ] in
  let c = corpus.corpus("toy", examples) in
  type.of(manifest.build_with_receipt(c, reg, g, "p0", 0.01)) == "record"
}

test "training manifest ok true" {
  let t = tensor.vector([1.0, 2.0, 3.0]) in
  let p = preg.parameter("p0", t, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    corpus.example("sky is blue", "accepted", "p0"),
    corpus.example("sky is green", "rejected", "p0")
  ] in
  let c = corpus.corpus("toy", examples) in
  let out = manifest.build_with_receipt(c, reg, g, "p0", 0.01) in
  out.manifest.ok == true
}

test "training manifest has digest" {
  let t = tensor.vector([1.0, 2.0, 3.0]) in
  let p = preg.parameter("p0", t, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    corpus.example("sky is blue", "accepted", "p0"),
    corpus.example("sky is green", "rejected", "p0")
  ] in
  let c = corpus.corpus("toy", examples) in
  let out = manifest.build_with_receipt(c, reg, g, "p0", 0.01) in
  str.starts_with(out.manifest_digest, "sha256:")
}

test "training manifest deterministic" {
  let t = tensor.vector([1.0, 2.0, 3.0]) in
  let p = preg.parameter("p0", t, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    corpus.example("sky is blue", "accepted", "p0"),
    corpus.example("sky is green", "rejected", "p0")
  ] in
  let c = corpus.corpus("toy", examples) in
  let a = manifest.build_with_receipt(c, reg, g, "p0", 0.01) in
  let b = manifest.build_with_receipt(c, reg, g, "p0", 0.01) in
  a.manifest_digest == b.manifest_digest
}
