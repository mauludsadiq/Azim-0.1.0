import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/weights") as weights
import("../packages/azim_trial/parameter_registry") as preg
import("../packages/azim_trial/module_graph") as mg
import("../packages/azim_trial/graph_train_replay") as replay
import("../packages/azim_trial/replay_verifier") as verify

test "receipt ok accepts sha256" {
  verify.receipt_ok("sha256:abc") == true
}

test "verify replay returns record" {
  
  let p = preg.parameter("W_U", weights.W_U, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    { parameter_id: "W_U", text: "sky is blue", label: "accepted" },
    { parameter_id: "W_U", text: "sky is green", label: "rejected" }
  ] in
  let out = replay.replay(examples, reg, g, 0.01) in
  let updated = preg.get_param(out.registry, "W_U") in
  type.of(verify.verify_replay(out, updated)) == "record"
}

test "verify replay ok true" {
  
  let p = preg.parameter("W_U", weights.W_U, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    { parameter_id: "W_U", text: "sky is blue", label: "accepted" },
    { parameter_id: "W_U", text: "sky is green", label: "rejected" }
  ] in
  let out = replay.replay(examples, reg, g, 0.01) in
  let updated = preg.get_param(out.registry, "W_U") in
  verify.verify_replay(out, updated).ok == true
}

test "verify replay receipt deterministic" {
  
  let p = preg.parameter("W_U", weights.W_U, true, "test") in
  let reg = preg.registry([p]) in
  let g = mg.graph([]) in
  let examples = [
    { parameter_id: "W_U", text: "sky is blue", label: "accepted" },
    { parameter_id: "W_U", text: "sky is green", label: "rejected" }
  ] in
  let out = replay.replay(examples, reg, g, 0.01) in
  let updated = preg.get_param(out.registry, "W_U") in
  let a = verify.verify_replay_with_receipt(out, updated) in
  let b = verify.verify_replay_with_receipt(out, updated) in
  (a.receipt == b.receipt) && str.starts_with(a.receipt, "sha256:")
}
