import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/final_audit_proof") as proof

test "audit config returns record" {
  type.of(proof.audit_config("azim_1p5b", 1500000000.0)) == "record"
}

test "audit config records 1p5b params" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  c.parameter_count == 1500000000.0
}

test "audit report defaults to not proven" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  let r = proof.audit_report(c) in
  r.ok == false
}

test "audit evidence derives true report" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  let e = {
    lawful_outputs: true,
    causal_independence_preserved: true,
    leakage_score: 0.01,
    receipts: ["sha256:a", "sha256:b"],
    replay_verified: true
  } in
  let r = proof.audit_report_from_evidence(c, e) in
  r.ok == true
}

test "audit evidence rejects leakage above threshold" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  let e = {
    lawful_outputs: true,
    causal_independence_preserved: true,
    leakage_score: 0.06,
    receipts: ["sha256:a"],
    replay_verified: true
  } in
  let r = proof.audit_report_from_evidence(c, e) in
  r.leakage_below_threshold == false && r.ok == false
}

test "audit evidence rejects bad receipt chain" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  let e = {
    lawful_outputs: true,
    causal_independence_preserved: true,
    leakage_score: 0.01,
    receipts: ["sha256:a", "bad"],
    replay_verified: true
  } in
  let r = proof.audit_report_from_evidence(c, e) in
  r.receipt_chain_complete == false && r.ok == false
}

test "proof receipt deterministic" {
  let c = proof.audit_config("azim_1p5b", 1500000000.0) in
  let a = proof.proof_with_receipt(c) in
  let b = proof.proof_with_receipt(c) in
  (a.receipt == b.receipt) && str.starts_with(a.receipt, "sha256:")
}
