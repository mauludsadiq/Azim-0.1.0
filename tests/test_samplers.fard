import("std/list") as list
import("std/type") as type
import("../packages/azim_trial/samplers") as s

let logits = [2.0, 1.0, 0.5, 0.1, 3.0, 0.2, 1.5, 0.8]

test "softmax_with_temp sums to 1" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let total = list.fold(probs, 0.0, fn(acc, x) { acc + x }) in
  total > 0.999 && total < 1.001
}

test "greedy returns argmax" {
  s.greedy(logits) == 4
}

test "top_k_mask keeps k elements" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let masked = s.top_k_mask(probs, 3) in
  list.len(list.filter(masked, fn(x) { x > 0.0 })) == 3
}

test "top_k_mask sums to 1" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let masked = s.top_k_mask(probs, 3) in
  let total = list.fold(masked, 0.0, fn(acc, x) { acc + x }) in
  total > 0.999 && total < 1.001
}

test "top_p_mask sums to 1" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let masked = s.top_p_mask(probs, 0.9) in
  let total = list.fold(masked, 0.0, fn(acc, x) { acc + x }) in
  total > 0.999 && total < 1.001
}

test "deterministic_sample returns valid index" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let idx = s.deterministic_sample(probs, "test_seed") in
  idx >= 0 && idx < list.len(logits)
}

test "deterministic_sample is deterministic" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let a = s.deterministic_sample(probs, "seed_42") in
  let b = s.deterministic_sample(probs, "seed_42") in
  a == b
}

test "different seeds give different samples" {
  let probs = s.softmax_with_temp(logits, 1.0) in
  let a = s.sample_top_k(logits, 5, 1.0, "seed_1") in
  let b = s.sample_top_k(logits, 5, 1.0, "seed_2") in
  type.of(a) == "int"
}

test "high temperature increases diversity" {
  let p_low  = s.softmax_with_temp(logits, 0.1) in
  let p_high = s.softmax_with_temp(logits, 2.0) in
  let max_low  = list.fold(p_low,  0.0, fn(acc, x) { if x > acc then x else acc }) in
  let max_high = list.fold(p_high, 0.0, fn(acc, x) { if x > acc then x else acc }) in
  max_low > max_high
}
