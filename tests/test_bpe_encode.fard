import("std/list") as list
import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/bpe_encode") as enc

let manifest = {
  merges: ["h e", "t h", "th e"],
  vocabulary: ["<PAD>", "<UNK>", "<BOS>", "<EOS>", "</w>", "h", "e", "t", "th", "he", "the"],
  manifest_sha256: "sha256:test"
}

test "encode word returns list" {
  let mm = enc.build_merge_map(manifest.merges) in
  type.of(enc.encode_word("the", mm)) == "list"
}

test "encode word applies merges" {
  let mm = enc.build_merge_map(manifest.merges) in
  let syms = enc.encode_word("the", mm) in
  list.len(syms) < 4
}

test "build vocab map returns record" {
  type.of(enc.build_vocab_map(manifest.vocabulary)) == "record"
}

test "detokenize removes special tokens" {
  let result = enc.detokenize([2, 5, 6, 3], manifest.vocabulary) in
  str.contains(result, "<BOS>") == false
}

test "encode text returns list with bos eos" {
  let mm = enc.build_merge_map(manifest.merges) in
  let vm = enc.build_vocab_map(manifest.vocabulary) in
  let ids = enc.encode_text("the", mm, vm, 1, 2, 3) in
  list.get(ids, 0) == 2
}
