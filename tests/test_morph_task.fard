import("std/list") as list
import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/morph_corpus") as mc
import("../packages/azim_trial/morph_task") as mt

test "morph task example returns record" {
  let e = mc.example("realize sky plural", "sky", "noun_plural", "skies") in
  type.of(mt.run_example(e)) == "record"
}

test "morph task example correct" {
  let e = mc.example("realize sky plural", "sky", "noun_plural", "skies") in
  let out = mt.run_example(e) in
  out.correct == true
}

test "morph task toy all lawful" {
  let out = mt.run_toy() in
  out.all_lawful == true
}

test "morph task toy all correct" {
  let out = mt.run_toy() in
  out.all_correct == true
}

test "morph task toy result count" {
  let out = mt.run_toy() in
  list.len(out.results) == out.count
}

test "morph task receipt deterministic" {
  let a = mt.run_toy_with_receipt() in
  let b = mt.run_toy_with_receipt() in
  (a.receipt == b.receipt) && str.starts_with(a.receipt, "sha256:")
}
