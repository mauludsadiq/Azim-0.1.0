import("std/list") as list
import("std/str") as str
import("std/rec") as rec
import("../packages/azim_trial/model") as model
import("../packages/azim_trial/receipts") as receipts

test "neural pass emits three logits" {
  let result = model.neural_pass("sky is blue") in
  list.len(result.logits) == 3
}

test "final verdict is neural label" {
  let claim = { predicate: "has-color", subject: "sky", property: "color", value: "blue" } in
  let out = model.infer_claim_with_receipt(claim) in
  out.inference.final_verdict == out.inference.model_label
}

test "final verdict is not semantic override" {
  let claim = { predicate: "has-color", subject: "sky", property: "color", value: "green" } in
  let out = model.infer_claim_with_receipt(claim) in
  out.inference.final_verdict == out.inference.model_label
}

test "semantic verdict preserved as diagnostic" {
  let claim = { predicate: "has-color", subject: "sky", property: "color", value: "blue" } in
  let out = model.infer_claim_with_receipt(claim) in
  out.inference.semantic_verdict == "accepted"
}

test "manifest receipt stable" {
  let a = receipts.manifest_sha256() in
  let b = receipts.manifest_sha256() in
  a == b
}
