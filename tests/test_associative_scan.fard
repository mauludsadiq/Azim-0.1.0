import("std/list") as list
import("std/str") as str
import("std/type") as type
import("../packages/azim_trial/tensor") as tensor
import("../packages/azim_trial/rssm") as rssm
import("../packages/azim_trial/associative_scan") as scan

test "associative scan segment returns record" {
  let s = rssm.init_state(3) in
  let xs = [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0])
  ] in
  type.of(scan.segment(xs, s)) == "record"
}

test "associative scan sequential returns tensor" {
  let s = rssm.init_state(3) in
  let xs = [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0])
  ] in
  type.of(scan.sequential(xs, s)) == "record"
}

test "associative scan equivalent true" {
  let s = rssm.init_state(3) in
  let xs = [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0])
  ] in
  let out = scan.scan_equivalent(xs, s) in
  out.equivalent == true
}

test "associative scan step count matches inputs" {
  let s = rssm.init_state(3) in
  let xs = [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0])
  ] in
  let out = scan.scan_equivalent(xs, s) in
  out.step_count == list.len(xs)
}

test "associative scan receipt deterministic" {
  let s = rssm.init_state(3) in
  let xs = [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0])
  ] in
  let a = scan.scan_with_receipt(xs, s) in
  let b = scan.scan_with_receipt(xs, s) in
  (a.receipt == b.receipt) && str.starts_with(a.receipt, "sha256:")
}
