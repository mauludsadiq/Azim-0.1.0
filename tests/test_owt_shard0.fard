import("../packages/azim_trial/weights") as weights
import("../packages/azim_trial/owt_loader") as loader
import("../packages/azim_trial/owt_train") as owt

let texts = loader.extract_shard_texts("/tmp/owt_0.parquet", 15, 50)
let result = owt.train_on_texts(weights.W_U, texts, 0.001)
{
  steps: result.steps,
  avg_loss: owt.avg_loss(result.losses),
  first_loss: result.losses,
  w_u_changed: result.W_U.data != weights.W_U.data
}
