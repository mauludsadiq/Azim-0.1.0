import("std/list") as list
import("std/str") as str
import("std/fs") as fs
import("std/json") as json
import("packages/azim_code/corpus_acquire") as ca

let repos = [
  { owner: "kennethreitz", repo: "requests" },
  { owner: "pallets", repo: "flask" },
  { owner: "psf", repo: "black" },
  { owner: "tiangolo", repo: "fastapi" },
  { owner: "numpy", repo: "numpy" }
]

let results = list.map(repos, fn(r) {
  ca.acquire_and_pack(r.owner, r.repo, 10, str.concat(["out/github_corpus/", r.repo]))
})

{
  repos: list.len(repos),
  total_accepted: list.fold(results, 0, fn(a, r) { a + r.accepted_count }),
  total_tokens: list.fold(results, 0, fn(a, r) { a + r.total_tokens }),
  results: list.map(list.range(0, list.len(results)), fn(i) {
    let r = list.get(results, i) in
    let repo = list.get(repos, i) in
    { repo: repo.repo, accepted: r.accepted_count, tokens: r.total_tokens }
  })
}
