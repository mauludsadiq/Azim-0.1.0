import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_file_r4",
  candidate_dir: "out/hybrid_file_r4/candidates",
  run_dir: "out/hybrid_file_r4/runs",
  accepted_out: "out/hybrid_file_r4/accepted",
  merged_out: "out/hybrid_file_r4/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function read_csv(path) that reads a CSV file and returns list of dicts",
    "Write a python function write_csv(path, rows) that writes list of dicts to CSV",
    "Write a python function read_json(path) that reads a JSON file and returns parsed object",
    "Write a python function write_json(path, obj) that writes object to JSON file",
    "Write a python function count_lines(path) that counts lines in a file",
    "Write a python function grep(path, pattern) that returns lines matching pattern",
    "Write a python function head(path, n) that returns first n lines of a file",
    "Write a python function tail(path, n) that returns last n lines of a file",
    "Write a python function word_count(path) that counts words in a file",
    "Write a python function find_files(directory, extension) that finds all files with extension",
    "Write a python function copy_file(src, dst) that copies a file",
    "Write a python function merge_files(paths, out) that merges multiple files into one",
    "Write a python function split_file(path, n) that splits file into n equal parts",
    "Write a python function replace_in_file(path, old, new) that replaces text in file",
    "Write a python function diff_files(path1, path2) that returns differing lines",
    "Write a python function parse_ini(path) that parses an INI config file",
    "Write a python function parse_log(path) that parses a log file into structured records",
    "Write a python function rotate_logs(path, max_size) that rotates log file when too large",
    "Write a python function checksum(path) that returns MD5 checksum of a file",
    "Write a python function watch_file(path, callback) that calls callback when file changes"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
