import("packages/azim_code/code_train_adapter") as standard
import("packages/azim_code/code_train_adapter_lowrank") as lowrank

let shard = "out/full_corpus_with_humaneval.jsonl"
let lr = 0.0005
let epsilon = 0.0001
let max_records = 20
let steps_per_record = 50

let standard_result = standard.train_shard(shard, "out/ab_standard_v2", lr, epsilon, max_records, steps_per_record)
let lowrank_r1_result = lowrank.train_shard_lowrank(shard, "out/ab_lowrank_r1_v2", lr, epsilon, 1, max_records, steps_per_record)
let lowrank_r4_result = lowrank.train_shard_lowrank(shard, "out/ab_lowrank_r4_v2", lr, epsilon, 4, max_records, steps_per_record)

{
  standard: {
    total_steps: standard_result.total_steps,
    loss_before: standard_result.avg_loss_before,
    loss_after: standard_result.avg_loss_after,
    delta: standard_result.avg_loss_delta
  },
  lowrank_rank1: {
    total_steps: lowrank_r1_result.total_steps,
    forward_evals: lowrank_r1_result.total_forward_evals,
    loss_before: lowrank_r1_result.avg_loss_before,
    loss_after: lowrank_r1_result.avg_loss_after,
    delta: lowrank_r1_result.avg_loss_delta
  },
  lowrank_rank4: {
    total_steps: lowrank_r4_result.total_steps,
    forward_evals: lowrank_r4_result.total_forward_evals,
    loss_before: lowrank_r4_result.avg_loss_before,
    loss_after: lowrank_r4_result.avg_loss_after,
    delta: lowrank_r4_result.avg_loss_delta
  }
}
