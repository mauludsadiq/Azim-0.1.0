# owt multi-shard
import("std/json") as json
import("std/fs") as fs
import("std/list") as list
import("packages/azim_trial/lm_owt_train") as owt
import("packages/azim_trial/lm_head") as lm
import("packages/azim_trial/tensor") as tensor

fn load_W(path) {
  let d = json.decode(fs.read_text(path)) in
  tensor.matrix(list.get(d.W_U_lm_dims, 0), list.get(d.W_U_lm_dims, 1), d.W_U_lm_data)
}

let W_start = load_W("out/lm_checkpoints2/shard_79.json")

let result = list.fold(list.range(0, 10), { W: W_start, losses: [] }, fn(acc, i) {
  let r = owt.train_shard(i, acc.W, 0.0005, 0.0001, 10, 5) in
  { W: r.W_U_lm, losses: list.append(acc.losses, r.avg_loss) }
})

{ losses: result.losses }
