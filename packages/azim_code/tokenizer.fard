import("std/str") as str
import("std/list") as list
import("std/rec") as rec
import("std/hash") as hash
import("std/json") as json

let special_tokens = ["<PAD>", "<UNK>", "<BOS>", "<EOS>", "<|LANG_FARD|>", "<|LANG_PYTHON|>", "<|LANG_RUST|>", "<|LANG_JS|>"]

let keyword_tokens = [
  "let", "in", "fn", "if", "then", "else",
  "import", "as", "export", "match", "using",
  "test", "while", "return",
  "true", "false", "null",
  "artifact", "a", "is", "or",
  "def", "class", "for", "with", "pass", "lambda",
  "yield", "from", "not", "and", "del", "raise",
  "try", "except", "finally", "global", "nonlocal",
  "async", "await", "self",
  "mut", "pub", "use", "mod", "struct", "enum",
  "impl", "trait", "where", "Self", "super", "crate",
  "loop", "break", "continue", "ref", "type",
  "unsafe", "move", "dyn",
  "var", "const", "function", "new", "this",
  "typeof", "instanceof", "void", "delete", "of",
  "get", "set", "switch", "case", "default",
  "do", "throw", "catch", "finally",
  "interface", "extends", "implements", "static",
  "None", "True", "False"
]

let symbol_tokens = [
  "!=", "==", "<=", ">=", "&&", "||", "->", "=>", "|>", "?.", "??", "...",
  "::", "**", "//", "/*", "*/", "+=", "-=", "*=", "/=", "%=",
  "&=", "|=", "^=", "<<", ">>", "<<<", ">>>",
  "(", ")", "{", "}", "[", "]", ",", ":", ".",
  "+", "-", "*", "/", "=", "%", "|", "<", ">",
  "?", "!", "&", "^", "~", "@", "#", ";"
]

let class_tokens = [
  "<IDENT>", "<INT>", "<FLOAT>", "<STRING>", "<BT_STRING>",
  "<DOC>", "<COMMENT>", "<NL>", "<WS>"
]

let vocabulary = list.concat([special_tokens, keyword_tokens, symbol_tokens, class_tokens])

let pad_id = 0
let unk_id = 1
let bos_id = 2
let eos_id = 3
let lang_fard_id = 4
let lang_python_id = 5
let lang_rust_id = 6
let lang_js_id = 7

let vocab_sha256 = hash.sha256_text(json.canonicalize(vocabulary))

fn vocab_size() {
  list.len(vocabulary)
}

fn vocab_map() {
  list.fold(list.range(0, list.len(vocabulary)), rec.empty(), fn(acc, i) {
    rec.set(acc, list.get(vocabulary, i), i)
  })
}

fn token_id(token) {
  rec.getOr(vocab_map(), token, unk_id)
}

fn token_at(i) {
  if i < 0 then "<UNK>"
  else if i >= list.len(vocabulary) then "<UNK>"
  else list.get(vocabulary, i)
}

fn is_alpha(c) {
  str.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_", c)
}

fn is_digit(c) {
  str.contains("0123456789", c)
}

fn is_alnum(c) {
  is_alpha(c) || is_digit(c)
}

fn peek(chars, i) {
  if i < list.len(chars) then list.get(chars, i) else ""
}

fn slice_chars(chars, start, end) {
  str.join(list.take(list.drop(chars, start), end - start), "")
}

fn scan_while(chars, start, pred_name) {
  let n = list.len(chars) in
  let init = { i: start, done: false } in
  let r = while init fn(s) { s.i < n && !s.done } fn(s) {
    let c = peek(chars, s.i) in
    let keep =
      if pred_name == "ident" then is_alnum(c)
      else if pred_name == "digit" then is_digit(c)
      else false in
    if keep then { i: s.i + 1, done: false } else { i: s.i, done: true }
  } in
  r.value.i
}

fn scan_to_eol(chars, start) {
  let n = list.len(chars) in
  let r = while { i: start, done: false } fn(s) { s.i < n && !s.done } fn(s) {
    if peek(chars, s.i) == "\n" then { i: s.i, done: true }
    else { i: s.i + 1, done: false }
  } in
  r.value.i
}

fn scan_block_comment(chars, start) {
  let n = list.len(chars) in
  let r = while { i: start + 2, done: false } fn(s) { s.i < n && !s.done } fn(s) {
    if peek(chars, s.i) == "*" && peek(chars, s.i + 1) == "/" then
      { i: s.i + 2, done: true }
    else { i: s.i + 1, done: false }
  } in
  r.value.i
}

fn scan_string(chars, start, quote) {
  let n = list.len(chars) in
  let r = while { i: start + 1, esc: false, done: false } fn(s) { s.i < n && !s.done } fn(s) {
    let c = peek(chars, s.i) in
    if quote == "`" then
      if c == "`" then { i: s.i + 1, esc: false, done: true }
      else { i: s.i + 1, esc: false, done: false }
    else if s.esc then { i: s.i + 1, esc: false, done: false }
    else if c == "\\" then { i: s.i + 1, esc: true, done: false }
    else if c == quote then { i: s.i + 1, esc: false, done: true }
    else { i: s.i + 1, esc: false, done: false }
  } in
  r.value.i
}

fn scan_number(chars, start) {
  let int_end = scan_while(chars, start, "digit") in
  if peek(chars, int_end) == "." && is_digit(peek(chars, int_end + 1)) then
    { end: scan_while(chars, int_end + 1, "digit"), kind: "float" }
  else { end: int_end, kind: "int" }
}

fn emit_token(acc, token, raw, start, end) {
  {
    ids: list.append(acc.ids, token_id(token)),
    pieces: list.append(acc.pieces, { token: token, raw: raw, start: start, end: end })
  }
}

fn tokenize_no_special_with_pieces(src) {
  let chars = str.chars(src) in
  let n = list.len(chars) in
  let r = while { i: 0, ids: [], pieces: [] } fn(s) { s.i < n } fn(s) {
    let c = peek(chars, s.i) in
    let c2 = peek(chars, s.i + 1) in
    let c3 = peek(chars, s.i + 2) in

    if c == "\n" then
      let e = emit_token(s, "<NL>", "\n", s.i, s.i + 1) in
      { i: s.i + 1, ids: e.ids, pieces: e.pieces }

    else if c == " " || c == "\t" then
      let end = while { j: s.i } fn(w) { w.j < n && (peek(chars, w.j) == " " || peek(chars, w.j) == "\t") } fn(w) { { j: w.j + 1 } } in
      let j = end.value.j in
      let e = emit_token(s, "<WS>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if c == "/" && c2 == "/" && c3 == "/" then
      let j = scan_to_eol(chars, s.i) in
      let e = emit_token(s, "<DOC>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if c == "/" && c2 == "*" then
      let j = scan_block_comment(chars, s.i) in
      let e = emit_token(s, "<COMMENT>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if (c == "/" && c2 == "/") || c == "#" then
      let j = scan_to_eol(chars, s.i) in
      let e = emit_token(s, "<COMMENT>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if c == "\"" || c == "'" then
      let j = scan_string(chars, s.i, c) in
      let e = emit_token(s, "<STRING>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if c == "`" then
      let j = scan_string(chars, s.i, "`") in
      let e = emit_token(s, "<BT_STRING>", slice_chars(chars, s.i, j), s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if c == "." && c2 == "." && c3 == "." then
      let e = emit_token(s, "...", "...", s.i, s.i + 3) in
      { i: s.i + 3, ids: e.ids, pieces: e.pieces }

    else if c == "<" && c2 == "<" && c3 == "<" then
      let e = emit_token(s, "<<<", "<<<", s.i, s.i + 3) in
      { i: s.i + 3, ids: e.ids, pieces: e.pieces }

    else if c == ">" && c2 == ">" && c3 == ">" then
      let e = emit_token(s, ">>>", ">>>", s.i, s.i + 3) in
      { i: s.i + 3, ids: e.ids, pieces: e.pieces }

    else if token_id(str.concat([c, c2])) != unk_id then
      let op = str.concat([c, c2]) in
      let e = emit_token(s, op, op, s.i, s.i + 2) in
      { i: s.i + 2, ids: e.ids, pieces: e.pieces }

    else if is_alpha(c) then
      let j = scan_while(chars, s.i, "ident") in
      let raw = slice_chars(chars, s.i, j) in
      let token = if rec.has(vocab_map(), raw) then raw else "<IDENT>" in
      let e = emit_token(s, token, raw, s.i, j) in
      { i: j, ids: e.ids, pieces: e.pieces }

    else if is_digit(c) then
      let nr = scan_number(chars, s.i) in
      let token = if nr.kind == "float" then "<FLOAT>" else "<INT>" in
      let e = emit_token(s, token, slice_chars(chars, s.i, nr.end), s.i, nr.end) in
      { i: nr.end, ids: e.ids, pieces: e.pieces }

    else
      let raw = c in
      let token = if token_id(raw) == unk_id then "<UNK>" else raw in
      let e = emit_token(s, token, raw, s.i, s.i + 1) in
      { i: s.i + 1, ids: e.ids, pieces: e.pieces }
  } in
  { ids: r.value.ids, pieces: r.value.pieces }
}

fn tokenize_no_special(src) {
  tokenize_no_special_with_pieces(src).ids
}

fn tokenize(src) {
  list.concat([[bos_id], tokenize_no_special(src), [eos_id]])
}

fn detokenize_ids(ids) {
  str.join(list.map(ids, fn(i) { token_at(i) }), "")
}

fn detokenize(ids) {
  str.replace(str.replace(detokenize_ids(ids), "<BOS>", ""), "<EOS>", "")
}

fn receipt_for(component, version, input, output_ids, pieces) {
  hash.sha256_text(json.canonicalize({
    component: component,
    version: version,
    vocab_sha256: vocab_sha256,
    input_sha256: hash.sha256_text(input),
    output_ids: output_ids,
    pieces: pieces
  }))
}

fn tokenize_with_receipt(src) {
  let r = tokenize_no_special_with_pieces(src) in
  let ids = list.concat([[bos_id], r.ids, [eos_id]]) in
  let receipt = receipt_for("azim_code.tokenizer", "2.1.0", src, ids, r.pieces) in
  { tokens: ids, pieces: r.pieces, receipt: receipt, vocab_sha256: vocab_sha256 }
}

export {
  vocabulary, pad_id, unk_id, bos_id, eos_id, lang_fard_id, lang_python_id, lang_rust_id, lang_js_id, vocab_sha256,
  vocab_size, vocab_map, token_id, token_at,
  tokenize_no_special_with_pieces, tokenize_no_special, tokenize,
  detokenize_ids, detokenize, receipt_for, tokenize_with_receipt
}
