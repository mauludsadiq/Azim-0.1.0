import("std/process") as process
import("std/fs") as fs
import("std/path") as path
import("std/str") as str
import("std/json") as json
import("std/hash") as hash

fn classify_output(exit_code, stdout, stderr) {
  let text = str.concat([stdout, "\n", stderr]) in
  if exit_code == 0 then "accepted"
  else if str.contains(text, "Parse") || str.contains(text, "parse") || str.contains(text, "unexpected token") then "syntax_error"
  else if str.contains(text, "arity") then "arity_error"
  else if str.contains(text, "undefined") || str.contains(text, "not found") then "undefined_symbol"
  else if str.contains(text, "type") || str.contains(text, "Type") then "type_error"
  else if str.contains(text, "timeout") then "timeout"
  else if str.contains(text, "test") || str.contains(text, "failed") then "test_failure"
  else "runtime_error"
}

fn run_program(program_path, out_dir) {
  let r = process.capture("fardrun", ["run", "--program", program_path, "--out", out_dir]) in
  let class = classify_output(r.exit_code, r.stdout, r.stderr) in
  let record = {
    mode: "run",
    program_path: program_path,
    out_dir: out_dir,
    ok: r.exit_code == 0,
    class: class,
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  {
    result: record,
    receipt: hash.sha256_text(json.canonicalize(record))
  }
}

fn test_program(program_path) {
  let r = process.capture("fardrun", ["test", "--program", program_path, "--json"]) in
  let class = classify_output(r.exit_code, r.stdout, r.stderr) in
  let record = {
    mode: "test",
    program_path: program_path,
    ok: r.exit_code == 0,
    class: class,
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  {
    result: record,
    receipt: hash.sha256_text(json.canonicalize(record))
  }
}

fn verify_run_out(out_dir) {
  let r = process.capture("fardrun", ["verify", "--out", out_dir, "--verbose"]) in
  let record = {
    mode: "verify",
    out_dir: out_dir,
    ok: r.exit_code == 0,
    class: if r.exit_code == 0 then "receipt_verified" else "receipt_mismatch",
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  {
    result: record,
    receipt: hash.sha256_text(json.canonicalize(record))
  }
}

fn write_candidate(path_out, source) {
  let parent = path.dir(path_out) in
  let _ = fs.make_dir(parent) in
  let _w = fs.write_text(path_out, source) in
  {
    path: path_out,
    source_sha256: hash.sha256_text(source)
  }
}

fn verify_candidate(source, candidate_path, out_dir) {
  let written = write_candidate(candidate_path, source) in
  let run_r = run_program(candidate_path, out_dir) in
  let verify_r = if run_r.result.ok then verify_run_out(out_dir) else {
    result: {
      mode: "verify",
      out_dir: out_dir,
      ok: false,
      class: "not_run",
      exit_code: -1,
      stdout: "",
      stderr: ""
    },
    receipt: "sha256:not_run"
  } in
  let record = {
    written: written,
    run: run_r,
    verify: verify_r,
    accepted: run_r.result.ok && verify_r.result.ok,
    class: if run_r.result.ok then verify_r.result.class else run_r.result.class
  } in
  {
    result: record,
    receipt: hash.sha256_text(json.canonicalize(record))
  }
}

fn run_python_check(program_path) {
  let r = process.capture("python3", ["-m", "py_compile", program_path]) in
  let record = {
    mode: "python_check",
    program_path: program_path,
    ok: r.exit_code == 0,
    class: classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  { result: record, receipt: hash.sha256_text(json.canonicalize(record)) }
}

fn run_rust_check(program_path) {
  let r = process.capture("rustc", ["--edition=2021", "--crate-type=lib", program_path]) in
  let record = {
    mode: "rust_check",
    program_path: program_path,
    ok: r.exit_code == 0,
    class: classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  { result: record, receipt: hash.sha256_text(json.canonicalize(record)) }
}

fn run_js_check(program_path) {
  let r = process.capture("node", ["--check", program_path]) in
  let record = {
    mode: "js_check",
    program_path: program_path,
    ok: r.exit_code == 0,
    class: classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr
  } in
  { result: record, receipt: hash.sha256_text(json.canonicalize(record)) }
}

fn verify_candidate_lang(source, candidate_path, out_dir, lang) {
  let written = write_candidate(candidate_path, source) in
  let check =
    if lang == "fard" then run_program(candidate_path, out_dir)
    else if lang == "python" then run_python_check(candidate_path)
    else if lang == "rust" then run_rust_check(candidate_path)
    else if lang == "javascript" then run_js_check(candidate_path)
    else {
      result: {
        mode: "unknown_check",
        program_path: candidate_path,
        ok: false,
        class: "unknown_language",
        exit_code: -1,
        stdout: "",
        stderr: ""
      },
      receipt: "sha256:unknown_language"
    } in

  let verify_r = if lang == "fard" && check.result.ok then verify_run_out(out_dir) else {
    result: {
      mode: "verify",
      out_dir: out_dir,
      ok: check.result.ok,
      class: if check.result.ok then "syntax_verified" else "not_run",
      exit_code: check.result.exit_code,
      stdout: "",
      stderr: ""
    },
    receipt: hash.sha256_text(json.canonicalize({
      lang: lang,
      candidate_path: candidate_path,
      ok: check.result.ok,
      class: if check.result.ok then "syntax_verified" else "not_run"
    }))
  } in

  let record = {
    lang: lang,
    written: written,
    check: check,
    verify: verify_r,
    accepted: check.result.ok && verify_r.result.ok,
    class: if check.result.ok then verify_r.result.class else check.result.class
  } in
  { result: record, receipt: hash.sha256_text(json.canonicalize(record)) }
}

fn execute_candidate_python(source, candidate_path, out_dir) {
  let _d = fs.make_dir(out_dir) in
  let written = write_candidate(candidate_path, source) in
  let r = process.capture("python3", [candidate_path]) in
  let record = {
    mode: "python_execute",
    lang: "python",
    candidate_path: candidate_path,
    out_dir: out_dir,
    written: written,
    ok: r.exit_code == 0,
    class: classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr,
    stdout_sha256: hash.sha256_text(r.stdout),
    stderr_sha256: hash.sha256_text(r.stderr),
    source_sha256: written.source_sha256
  } in
  let receipt = hash.sha256_text(json.canonicalize(record)) in
  let _w = fs.write_text(path.join(out_dir, "python_execution_result.json"), json.canonicalize({
    result: record,
    receipt: receipt
  })) in
  {
    result: record,
    receipt: receipt
  }
}


fn execute_candidate_js(source, candidate_path, out_dir) {
  let _d = fs.make_dir(out_dir) in
  let written = write_candidate(candidate_path, source) in
  let r = process.capture("node", [candidate_path]) in
  let record = {
    mode: "js_execute",
    lang: "javascript",
    candidate_path: candidate_path,
    out_dir: out_dir,
    written: written,
    ok: r.exit_code == 0,
    class: classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr,
    stdout_sha256: hash.sha256_text(r.stdout),
    stderr_sha256: hash.sha256_text(r.stderr),
    source_sha256: written.source_sha256
  } in
  let receipt = hash.sha256_text(json.canonicalize(record)) in
  let _w = fs.write_text(path.join(out_dir, "js_execution_result.json"), json.canonicalize({
    result: record, receipt: receipt
  })) in
  { result: record, receipt: receipt }
}


fn execute_candidate_rust(source, candidate_path, out_dir) {
  let _d = fs.make_dir(out_dir) in
  let written = write_candidate(candidate_path, source) in
  let bin_path = path.join(out_dir, "candidate_bin") in
  let compile = process.capture("rustc", ["--edition=2021", candidate_path, "-o", bin_path]) in
  if compile.exit_code != 0 then
    let record = {
      mode: "rust_execute",
      lang: "rust",
      candidate_path: candidate_path,
      out_dir: out_dir,
      written: written,
      ok: false,
      class: "compile_error",
      exit_code: compile.exit_code,
      stdout: compile.stdout,
      stderr: compile.stderr,
      stdout_sha256: hash.sha256_text(compile.stdout),
      stderr_sha256: hash.sha256_text(compile.stderr),
      source_sha256: written.source_sha256
    } in
    let receipt = hash.sha256_text(json.canonicalize(record)) in
    let _w = fs.write_text(path.join(out_dir, "rust_execution_result.json"), json.canonicalize({
      result: record, receipt: receipt
    })) in
    { result: record, receipt: receipt }
  else
    let run = process.capture(bin_path, []) in
    let record = {
      mode: "rust_execute",
      lang: "rust",
      candidate_path: candidate_path,
      out_dir: out_dir,
      written: written,
      ok: run.exit_code == 0,
      class: classify_output(run.exit_code, run.stdout, run.stderr),
      exit_code: run.exit_code,
      stdout: run.stdout,
      stderr: run.stderr,
      stdout_sha256: hash.sha256_text(run.stdout),
      stderr_sha256: hash.sha256_text(run.stderr),
      source_sha256: written.source_sha256
    } in
    let receipt = hash.sha256_text(json.canonicalize(record)) in
    let _w = fs.write_text(path.join(out_dir, "rust_execution_result.json"), json.canonicalize({
      result: record, receipt: receipt
    })) in
    { result: record, receipt: receipt }
}

fn execute_candidate_fard(source, candidate_path, out_dir) {
  let _d = fs.make_dir(out_dir) in
  let written = write_candidate(candidate_path, source) in
  let run_out = path.join(out_dir, "fard_run") in
  let r = process.capture("fardrun", ["run", "--program", candidate_path, "--out", run_out]) in
  let record = {
    mode: "fard_execute",
    lang: "fard",
    candidate_path: candidate_path,
    out_dir: out_dir,
    written: written,
    ok: r.exit_code == 0,
    class: if r.exit_code == 0 then "accepted" else classify_output(r.exit_code, r.stdout, r.stderr),
    exit_code: r.exit_code,
    stdout: r.stdout,
    stderr: r.stderr,
    stdout_sha256: hash.sha256_text(r.stdout),
    stderr_sha256: hash.sha256_text(r.stderr),
    source_sha256: written.source_sha256,
    run_out: run_out
  } in
  let receipt = hash.sha256_text(json.canonicalize(record)) in
  let _w = fs.write_text(path.join(out_dir, "fard_execution_result.json"), json.canonicalize({
    result: record, receipt: receipt
  })) in
  { result: record, receipt: receipt }
}

export { classify_output, run_program, test_program, verify_run_out, write_candidate, verify_candidate, run_python_check, run_rust_check, run_js_check, verify_candidate_lang, execute_candidate_python, execute_candidate_js, execute_candidate_rust, execute_candidate_fard }
