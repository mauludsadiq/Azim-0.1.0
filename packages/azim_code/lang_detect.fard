import("std/str") as str

fn detect(path) {
  if str.ends_with(path, ".py") then "python"
  else if str.ends_with(path, ".rs") then "rust"
  else if str.ends_with(path, ".js") then "javascript"
  else if str.ends_with(path, ".ts") then "typescript"
  else if str.ends_with(path, ".java") then "java"
  else if str.ends_with(path, ".fard") then "fard"
  else if str.ends_with(path, ".go") then "go"
  else if str.ends_with(path, ".c") then "c"
  else if str.ends_with(path, ".cpp") then "cpp"
  else "unknown"
}

fn is_code(path) {
  detect(path) != "unknown"
}

export { detect, is_code }
