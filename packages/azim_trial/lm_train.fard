import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("tensor") as tensor
import("tokenizer") as tok
import("lm_head") as lm

let n_params = list.len(lm.W_U_lm.data)

let fixed_direction = tensor.matrix(
  list.get(lm.W_U_lm.dims, 0),
  list.get(lm.W_U_lm.dims, 1),
  list.build(n_params, fn(i) {
    let h = hash.sha256_text(json.canonicalize({ seed: "lm_spsa_v1", i: i })) in
    let c = str.slice(h, 7, 8) in
    if c == "0" || c == "1" || c == "2" || c == "3" ||
       c == "4" || c == "5" || c == "6" || c == "7"
    then 1.0 else -1.0
  })
)

fn nll_at_pos(W_U_lm, token_ids, pos) {
  let prefix = list.take(token_ids, pos + 1) in
  let hidden = lm.hidden_for_tokens(prefix) in
  let logits = tensor.matvec(W_U_lm, hidden) in
  let target = list.get(token_ids, pos + 1) in
  lm.nll_token(logits, target)
}

fn pick_pos(token_ids, step_index) {
  let n = list.len(token_ids) in
  if n < 2 then 0 else
  step_index % (n - 1)
}

fn lm_train_step(W_U_lm, text, lr, epsilon) {
  let token_ids = list.take(tok.tokenize(text), 16) in
  let n = list.len(token_ids) in
  if n < 2 then { loss_before: 0.0, loss_after: 0.0, loss_delta: 0.0, W_U_lm: W_U_lm } else
  let pos = 0 in
  let loss_before = nll_at_pos(W_U_lm, token_ids, pos) in
  let W_plus = tensor.matrix(list.get(W_U_lm.dims, 0), list.get(W_U_lm.dims, 1),
    list.build(n_params, fn(i) {
      list.get(W_U_lm.data, i) + epsilon * list.get(fixed_direction.data, i)
    })) in
  let W_minus = tensor.matrix(list.get(W_U_lm.dims, 0), list.get(W_U_lm.dims, 1),
    list.build(n_params, fn(i) {
      list.get(W_U_lm.data, i) - epsilon * list.get(fixed_direction.data, i)
    })) in
  let l_plus  = nll_at_pos(W_plus,  token_ids, pos) in
  let l_minus = nll_at_pos(W_minus, token_ids, pos) in
  let scale = (l_plus - l_minus) / (2.0 * epsilon) in
  let flat_W = tensor.vector(W_U_lm.data) in
  let grad_flat = tensor.vector(list.build(n_params, fn(i) {
    scale * list.get(fixed_direction.data, i)
  })) in
  let updated_flat = tensor.sub(flat_W, tensor.scale(grad_flat, lr)) in
  let W_updated = tensor.matrix(list.get(W_U_lm.dims, 0), list.get(W_U_lm.dims, 1), updated_flat.data) in
  let loss_after = nll_at_pos(W_updated, token_ids, pos) in
  {
    loss_before: loss_before,
    loss_after: loss_after,
    loss_delta: loss_after - loss_before,
    W_U_lm: W_updated
  }
}

fn lm_train_receipt(step) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.lm_train",
    version: "1.2.0",
    loss_before: step.loss_before,
    loss_after: step.loss_after
  }))
}

fn lm_train_step_with_receipt(W_U_lm, text, lr, epsilon) {
  let step = lm_train_step(W_U_lm, text, lr, epsilon) in
  let receipt = lm_train_receipt(step) in
  { step: step, receipt: receipt }
}

export {
  fixed_direction,
  nll_at_pos,
  lm_train_step,
  lm_train_receipt,
  lm_train_step_with_receipt
}
