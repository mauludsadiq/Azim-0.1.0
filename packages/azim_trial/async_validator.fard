import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("leakage_probe") as lp
import("tower_independence") as ti
import("rssm") as rssm

fn validator_config(name, cadence_steps, sidechain_enabled, backpressure_enabled) {
  {
    name: name,
    cadence_steps: cadence_steps,
    sidechain_enabled: sidechain_enabled,
    backpressure_enabled: backpressure_enabled
  }
}

fn probe(name, axis, passed) {
  {
    name: name,
    axis: axis,
    passed: passed
  }
}

fn semantic_probe(text) {
  let state = rssm.init_state(3) in
  let result = lp.probe(text, state) in
  probe("semantic_probe", "semantic", result.clean_split)
}

fn independence_probe(text) {
  let result = ti.independence_report(text, 3) in
  probe("gradient_probe", "optimization", result.l0_stable)
}

fn receipt_probe(receipt) {
  probe("receipt_probe", "verification", str.starts_with(receipt, "sha256:"))
}

fn probe_suite_for(text, sample_receipt) {
  [
    semantic_probe(text),
    independence_probe(text),
    receipt_probe(sample_receipt)
  ]
}

fn validator_run(config) {
  let sample_text = "sky has-color blue" in
  let sample_receipt = hash.sha256_text(json.canonicalize({ sample: sample_text })) in
  let probes = probe_suite_for(sample_text, sample_receipt) in
  let passed = list.all(probes, fn(p) { p.passed }) in
  {
    config: config,
    probes: probes,
    probe_count: list.len(probes),
    cadence_steps: config.cadence_steps,
    sidechain_enabled: config.sidechain_enabled,
    backpressure_enabled: config.backpressure_enabled,
    probes_ok: passed,
    ok: passed && config.sidechain_enabled && config.backpressure_enabled
  }
}

fn validator_receipt(report) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.async_validator",
    version: "phase7.1",
    report: report
  }))
}

fn validator_with_receipt(config) {
  let report = validator_run(config) in
  let receipt = validator_receipt(report) in
  { report: report, receipt: receipt }
}

fn probe_suite() {
  probe_suite_for("sky has-color blue", "sha256:000")
}

export {
  validator_config,
  probe_suite,
  probe,
  probe_suite_for,
  validator_run,
  validator_receipt,
  validator_with_receipt
}
