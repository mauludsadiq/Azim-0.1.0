import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("std/math") as math
import("tensor") as tensor

fn rotating_dir(data, step, seed_int) {
  let seed = hash.sha256_text(json.canonicalize({
    w0: list.get(data, 0),
    step: step,
    seed: seed_int
  })) in
  list.build(list.len(data), fn(i) {
    let h = hash.sha256_text(json.canonicalize({ seed: seed, i: i })) in
    let c = str.slice(h, 7, 8) in
    if c == "0" || c == "1" || c == "2" || c == "3" ||
       c == "4" || c == "5" || c == "6" || c == "7"
    then 1.0 else -1.0
  })
}

fn spsa_grad_one(data, dir, l_plus, l_minus, epsilon) {
  let scale = (l_plus - l_minus) / (2.0 * epsilon) in
  list.build(list.len(data), fn(i) { scale * list.get(dir, i) })
}

fn multi_direction_grad(data, dirs, l_plusses, l_minuses, epsilon) {
  let k = list.len(dirs) in
  let grads = list.map(list.range(0, k), fn(ki) {
    spsa_grad_one(data,
      list.get(dirs, ki),
      list.get(l_plusses, ki),
      list.get(l_minuses, ki),
      epsilon)
  }) in
  let n = list.len(data) in
  let summed = list.fold(grads, list.build(n, fn(_) { 0.0 }), fn(acc, g) {
    list.build(n, fn(i) { list.get(acc, i) + list.get(g, i) })
  }) in
  list.build(n, fn(i) { list.get(summed, i) / (k + 0.0) })
}

fn apply_grad(data, grad, lr) {
  list.build(list.len(data), fn(i) {
    list.get(data, i) - lr * list.get(grad, i)
  })
}

fn multi_spsa_step(data, step, k, epsilon, lr, loss_fn, make_W) {
  let dirs = list.map(list.range(0, k), fn(ki) {
    rotating_dir(data, step * k + ki, step + ki + 1)
  }) in
  let l_plusses = list.map(dirs, fn(d) {
    let d_plus = list.build(list.len(data), fn(i) {
      list.get(data, i) + epsilon * list.get(d, i)
    }) in
    loss_fn(make_W(d_plus))
  }) in
  let l_minuses = list.map(dirs, fn(d) {
    let d_minus = list.build(list.len(data), fn(i) {
      list.get(data, i) - epsilon * list.get(d, i)
    }) in
    loss_fn(make_W(d_minus))
  }) in
  let grad = multi_direction_grad(data, dirs, l_plusses, l_minuses, epsilon) in
  let new_data = apply_grad(data, grad, lr) in
  {
    data: new_data,
    grad: grad,
    l_plusses: l_plusses,
    l_minuses: l_minuses
  }
}

export { rotating_dir, spsa_grad_one, multi_direction_grad, apply_grad, multi_spsa_step }
