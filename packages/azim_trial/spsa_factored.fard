import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("std/math") as math
import("tensor") as tensor

fn rand_pm1_vec(n, seed) {
  list.build(n, fn(i) {
    let h = hash.sha256_text(json.canonicalize({ seed: seed, i: i })) in
    let c = str.slice(h, 7, 8) in
    if c == "0" || c == "1" || c == "2" || c == "3" ||
       c == "4" || c == "5" || c == "6" || c == "7"
    then 1.0 else -1.0
  })
}

# A: tensor matrix rows x r
# B: tensor matrix r x cols
# returns tensor matrix rows x cols
fn W_from_factors_t(W_base, A, B, alpha, r) {
  let scale = alpha / (r + 0.0) in
  let AB = tensor.matmul(A, B) in
  tensor.matrix(list.get(W_base.dims, 0), list.get(W_base.dims, 1),
    list.build(list.len(W_base.data), fn(i) {
      list.get(W_base.data, i) + scale * list.get(AB.data, i)
    }))
}

# LoRA-SPSA with K directions, A-only training, native tensor ops
fn lora_spsa_step_k(W_base, A, B, rows, cols, r, alpha, step, k_dirs, epsilon, lr, loss_fn) {
  let nA = rows * r in
  let dirs = list.map(list.range(0, k_dirs), fn(ki) {
    rand_pm1_vec(nA, step * k_dirs + ki + 1)
  }) in
  let grad_estimates = list.map(dirs, fn(d) {
    let A_plus_data  = list.build(nA, fn(i) { list.get(A.data, i) + epsilon * list.get(d, i) }) in
    let A_minus_data = list.build(nA, fn(i) { list.get(A.data, i) - epsilon * list.get(d, i) }) in
    let A_plus  = tensor.matrix(rows, r, A_plus_data) in
    let A_minus = tensor.matrix(rows, r, A_minus_data) in
    let W_plus  = W_from_factors_t(W_base, A_plus,  B, alpha, r) in
    let W_minus = W_from_factors_t(W_base, A_minus, B, alpha, r) in
    let l_plus  = loss_fn(W_plus) in
    let l_minus = loss_fn(W_minus) in
    let g = (l_plus - l_minus) / (2.0 * epsilon) in
    list.build(nA, fn(i) { g * list.get(d, i) })
  }) in
  let avg_grad = list.fold(grad_estimates,
    list.build(nA, fn(i) { 0.0 }),
    fn(acc, g) { list.build(nA, fn(i) { list.get(acc, i) + list.get(g, i) }) }
  ) in
  let avg_grad_scaled = list.build(nA, fn(i) { list.get(avg_grad, i) / (k_dirs + 0.0) }) in
  let A_new_data = list.build(nA, fn(i) {
    let raw = list.get(A.data, i) - lr * list.get(avg_grad_scaled, i) in
    if raw > 10.0 then 10.0 else if raw < -10.0 then -10.0 else raw
  }) in
  let A_new = tensor.matrix(rows, r, A_new_data) in
  let loss_before = loss_fn(W_from_factors_t(W_base, A, B, alpha, r)) in
  let W_new = W_from_factors_t(W_base, A_new, B, alpha, r) in
  let loss_after = loss_fn(W_new) in
  {
    A: A_new,
    B: B,
    W_eff: W_new,
    loss_before: loss_before,
    loss_after: loss_after,
    forward_evals: 2 * k_dirs,
    factored_dim: nA,
    full_dim: rows * cols
  }
}

# Standard SPSA on full W using native tensor ops
fn standard_spsa_step(W, step, epsilon, lr, loss_fn) {
  let rows = list.get(W.dims, 0) in
  let cols = list.get(W.dims, 1) in
  let n = rows * cols in
  let dir = rand_pm1_vec(n, step + 1) in
  let W_plus  = tensor.matrix(rows, cols, list.build(n, fn(i) { list.get(W.data, i) + epsilon * list.get(dir, i) })) in
  let W_minus = tensor.matrix(rows, cols, list.build(n, fn(i) { list.get(W.data, i) - epsilon * list.get(dir, i) })) in
  let l_plus  = loss_fn(W_plus) in
  let l_minus = loss_fn(W_minus) in
  let scale = (l_plus - l_minus) / (2.0 * epsilon) in
  let W_new = tensor.matrix(rows, cols, list.build(n, fn(i) {
    list.get(W.data, i) - lr * scale * list.get(dir, i)
  })) in
  let loss_before = loss_fn(W) in
  let loss_after  = loss_fn(W_new) in
  {
    W: W_new,
    loss_before: loss_before,
    loss_after: loss_after,
    forward_evals: 2
  }
}

export { rand_pm1_vec, W_from_factors_t, lora_spsa_step_k, standard_spsa_step }
