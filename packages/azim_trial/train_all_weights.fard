import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("std/math") as math
import("tensor") as tensor
import("weights_32") as w
import("block_32") as b32

fn rotating_dir(data, step, seed_int) {
  let seed = hash.sha256_text(json.canonicalize({
    w0: list.get(data, 0), step: step, seed: seed_int
  })) in
  list.build(list.len(data), fn(i) {
    let h = hash.sha256_text(json.canonicalize({ seed: seed, i: i })) in
    let c = str.slice(h, 7, 8) in
    if c == "0" || c == "1" || c == "2" || c == "3" ||
       c == "4" || c == "5" || c == "6" || c == "7"
    then 1.0 else -1.0
  })
}

fn logsumexp(xs) {
  let maxv = list.fold(xs, list.get(xs, 0), fn(acc, x) { if x > acc then x else acc }) in
  let exps = list.map(xs, fn(x) { math.exp(x - maxv) }) in
  let total = list.fold(exps, 0.0, fn(acc, x) { acc + x }) in
  maxv + math.log(if total > 0.0 then total else 0.000001)
}

fn nll_state(state, token_ids, pos) {
  let prefix = list.take(token_ids, pos + 1) in
  let vectors = list.map(prefix, fn(id) { w.embedding_row(id) }) in
  let h1 = b32.transformer_block(vectors,
    state.WQ, state.WK, state.WV, state.WO,
    state.Wg, state.Wu, state.Wd) in
  let h1v = list.concat([vectors, [h1]]) in
  let h2 = b32.transformer_block(h1v,
    state.WQ2, state.WK2, state.WV2, state.WO2,
    state.Wg2, state.Wu2, state.Wd2) in
  let hidden = tensor.rms_norm(h2, 0.000001) in
  let logits = tensor.matvec(state.W_U, hidden) in
  let target = list.get(token_ids, pos + 1) in
  logsumexp(logits.data) - list.get(logits.data, target)
}

fn spsa_update(data, dir, l_plus, l_minus, lr, epsilon) {
  let scale = (l_plus - l_minus) / (2.0 * epsilon) in
  list.build(list.len(data), fn(i) {
    list.get(data, i) - lr * scale * list.get(dir, i)
  })
}

fn with_W_U(state, d) {
  { W_U: tensor.matrix(list.get(state.W_U.dims,0), list.get(state.W_U.dims,1), d),
    WQ: state.WQ, WK: state.WK, WV: state.WV, WO: state.WO,
    Wg: state.Wg, Wu: state.Wu, Wd: state.Wd,
    WQ2: state.WQ2, WK2: state.WK2, WV2: state.WV2, WO2: state.WO2,
    Wg2: state.Wg2, Wu2: state.Wu2, Wd2: state.Wd2 }
}

fn with_WQ(state, d) {
  { W_U: state.W_U,
    WQ: tensor.matrix(list.get(state.WQ.dims,0), list.get(state.WQ.dims,1), d),
    WK: state.WK, WV: state.WV, WO: state.WO,
    Wg: state.Wg, Wu: state.Wu, Wd: state.Wd,
    WQ2: state.WQ2, WK2: state.WK2, WV2: state.WV2, WO2: state.WO2,
    Wg2: state.Wg2, Wu2: state.Wu2, Wd2: state.Wd2 }
}

fn with_WK(state, d) {
  { W_U: state.W_U, WQ: state.WQ,
    WK: tensor.matrix(list.get(state.WK.dims,0), list.get(state.WK.dims,1), d),
    WV: state.WV, WO: state.WO,
    Wg: state.Wg, Wu: state.Wu, Wd: state.Wd,
    WQ2: state.WQ2, WK2: state.WK2, WV2: state.WV2, WO2: state.WO2,
    Wg2: state.Wg2, Wu2: state.Wu2, Wd2: state.Wd2 }
}

fn with_WV(state, d) {
  { W_U: state.W_U, WQ: state.WQ, WK: state.WK,
    WV: tensor.matrix(list.get(state.WV.dims,0), list.get(state.WV.dims,1), d),
    WO: state.WO, Wg: state.Wg, Wu: state.Wu, Wd: state.Wd,
    WQ2: state.WQ2, WK2: state.WK2, WV2: state.WV2, WO2: state.WO2,
    Wg2: state.Wg2, Wu2: state.Wu2, Wd2: state.Wd2 }
}

fn with_WO(state, d) {
  { W_U: state.W_U, WQ: state.WQ, WK: state.WK, WV: state.WV,
    WO: tensor.matrix(list.get(state.WO.dims,0), list.get(state.WO.dims,1), d),
    Wg: state.Wg, Wu: state.Wu, Wd: state.Wd,
    WQ2: state.WQ2, WK2: state.WK2, WV2: state.WV2, WO2: state.WO2,
    Wg2: state.Wg2, Wu2: state.Wu2, Wd2: state.Wd2 }
}

fn step_block(state, data, dims, dir, epsilon, lr, ids, pos, with_fn) {
  let n = list.len(data) in
  let d_plus  = list.build(n, fn(i) { list.get(data, i) + epsilon * list.get(dir, i) }) in
  let d_minus = list.build(n, fn(i) { list.get(data, i) - epsilon * list.get(dir, i) }) in
  let l_plus  = nll_state(with_fn(d_plus),  ids, pos) in
  let l_minus = nll_state(with_fn(d_minus), ids, pos) in
  let new_data = spsa_update(data, dir, l_plus, l_minus, lr, epsilon) in
  with_fn(new_data)
}

fn train_step(state, token_ids, lr, epsilon, step) {
  let ids = list.take(token_ids, 12) in
  let n = list.len(ids) in
  if n < 2 then state else
  let pos = 1 + (step % (n - 2)) in
  let loss_before = nll_state(state, ids, pos) in
  let s1 = step_block(state, state.W_U.data, state.W_U.dims,
    rotating_dir(state.W_U.data, step, 1), epsilon, lr, ids, pos,
    fn(d) { with_W_U(state, d) }) in
  let s2 = step_block(s1, s1.WQ.data, s1.WQ.dims,
    rotating_dir(s1.WQ.data, step, 2), epsilon, lr, ids, pos,
    fn(d) { with_WQ(s1, d) }) in
  let s3 = step_block(s2, s2.WK.data, s2.WK.dims,
    rotating_dir(s2.WK.data, step, 3), epsilon, lr, ids, pos,
    fn(d) { with_WK(s2, d) }) in
  let s4 = step_block(s3, s3.WV.data, s3.WV.dims,
    rotating_dir(s3.WV.data, step, 4), epsilon, lr, ids, pos,
    fn(d) { with_WV(s3, d) }) in
  let s5 = step_block(s4, s4.WO.data, s4.WO.dims,
    rotating_dir(s4.WO.data, step, 5), epsilon, lr, ids, pos,
    fn(d) { with_WO(s4, d) }) in
  { W_U: s5.W_U, WQ: s5.WQ, WK: s5.WK, WV: s5.WV, WO: s5.WO,
    Wg: s5.Wg, Wu: s5.Wu, Wd: s5.Wd,
    WQ2: s5.WQ2, WK2: s5.WK2, WV2: s5.WV2, WO2: s5.WO2,
    Wg2: s5.Wg2, Wu2: s5.Wu2, Wd2: s5.Wd2,
    loss: loss_before, step: step }
}

let init_state = {
  W_U: w.W_U_lm,
  WQ: w.W_Q, WK: w.W_K, WV: w.W_V, WO: w.W_O,
  Wg: w.W_gate, Wu: w.W_up, Wd: w.W_down,
  WQ2: w.W_Q2, WK2: w.W_K2, WV2: w.W_V2, WO2: w.W_O2,
  Wg2: w.W_gate2, Wu2: w.W_up2, Wd2: w.W_down2
}

export { rotating_dir, logsumexp, nll_state, train_step, init_state }
