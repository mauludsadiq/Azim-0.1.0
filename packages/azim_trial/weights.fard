import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/math") as math
import("tensor") as tensor

let model_config = {
  name: "azim-trial-tiny-deterministic-decoder",
  version: "0.3.0",
  d_model: 8,
  d_ff: 16,
  max_seq: 64,
  heads: 1,
  seed_label: "azim-trial-fixed-table-v3"
}

let label_tokens = ["accepted", "rejected", "needs-evidence"]

fn det_val(seed, i) {
  let x = (seed * 1664525 + i * 1013904223) % 2147483648 in
  let f = (x % 1000) + 0.0 in
  (f / 500.0) - 1.0
}

fn emb_val(token_id, dim) {
  det_val(token_id * 31 + 7, dim * 17 + 3)
}

fn embedding_row(token_id) {
  tensor.vector(list.build(8, fn(d) { emb_val(token_id, d) }))
}

let W_Q = tensor.matrix(8, 8, list.build(64, fn(i) { det_val(101, i) }))
let W_K = tensor.matrix(8, 8, list.build(64, fn(i) { det_val(202, i) }))
let W_V = tensor.matrix(8, 8, list.build(64, fn(i) { det_val(303, i) }))
let W_O = tensor.matrix(8, 8, list.build(64, fn(i) { det_val(404, i) }))
let W_gate = tensor.matrix(16, 8, list.build(128, fn(i) { det_val(505, i) }))
let W_up = tensor.matrix(16, 8, list.build(128, fn(i) { det_val(606, i) }))
let W_down = tensor.matrix(8, 16, list.build(128, fn(i) { det_val(707, i) }))
let W_U = tensor.matrix(3, 8, list.build(24, fn(i) { det_val(808, i) }))

fn weights_record() {
  {
    config: model_config,
    W_Q: W_Q,
    W_K: W_K,
    W_V: W_V,
    W_O: W_O,
    W_gate: W_gate,
    W_up: W_up,
    W_down: W_down,
    W_U: W_U,
    label_tokens: label_tokens
  }
}

let weights_sha256 = hash.sha256_text(json.canonicalize(weights_record()))

export { model_config, label_tokens, embedding_row, W_Q, W_K, W_V, W_O, W_gate, W_up, W_down, W_U, weights_record, weights_sha256 }
