import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("std/str") as str
import("std/fs") as fs
import("owt_loader") as loader
import("lm_train_cached") as lmt
import("lm_head") as lm
import("tokenizer") as tok

fn is_clean(text) {
  list.len(str.split(text, " ")) > 5
}

fn precompute_hidden(text) {
  let token_ids = tok.tokenize(text) in
  let prefix = list.take(token_ids, 16) in
  let n = list.len(prefix) in
  if n < 2 then [] else
  let pos = 0 in
  let hidden = lm.hidden_for_tokens(list.take(prefix, pos + 1)) in
  let target = list.get(prefix, pos + 1) in
  [{ hidden: hidden, target: target }]
}

fn train_doc_cached(W, hidden_targets, lr, epsilon, steps_per_doc) {
  list.fold(list.range(0, steps_per_doc), { W: W, losses: [] }, fn(acc, step) {
    let ht = list.get(hidden_targets, 0) in
    let s = lmt.lm_train_step_cached(acc.W, ht.hidden, ht.target, lr, epsilon) in
    { W: s.W_U_lm, losses: list.append(acc.losses, s.loss_before) }
  })
}

fn train_shard_cached(shard_index, W_U_lm, lr, epsilon, max_docs, steps_per_doc) {
  let shard_path = str.concat(["out/owt_shard_", str.from(shard_index), ".parquet"]) in
  let _ = loader.download_shard(shard_index, shard_path) in
  let texts = loader.extract_shard_texts(shard_path, 10, max_docs) in
  let result = list.fold(texts, { W: W_U_lm, steps: 0, losses: [] }, fn(acc, text) {
    if is_clean(text) then
      let hts = precompute_hidden(text) in
      let doc_result = train_doc_cached(acc.W, hts, lr, epsilon, steps_per_doc) in
      let avg = list.fold(doc_result.losses, 0.0, fn(a, x) { a + x }) / list.len(doc_result.losses) in
      { W: doc_result.W, steps: acc.steps + steps_per_doc, losses: list.append(acc.losses, avg) }
    else acc
  }) in
  let avg_loss = if list.len(result.losses) == 0 then 0.0 else
    list.fold(result.losses, 0.0, fn(a, x) { a + x }) / list.len(result.losses) in
  let receipt = hash.sha256_text(json.canonicalize({
    component: "azim_trial.lm_owt_train_cached",
    version: "2.0.0",
    shard_index: shard_index,
    steps: result.steps,
    avg_loss: avg_loss
  })) in
  let ckpt = json.canonicalize({
    version: "2.0.0",
    shard_index: shard_index,
    avg_loss: avg_loss,
    steps: result.steps,
    receipt: receipt,
    W_U_lm_dims: result.W.dims,
    W_U_lm_data: result.W.data
  }) in
  let _ = fs.make_dir("out/lm_checkpoints2") in
  let _ = fs.write_text(str.concat(["out/lm_checkpoints2/shard_", str.from(shard_index), ".json"]), ckpt) in
  let _ = loader.delete_shard(shard_path) in
  { shard_index: shard_index, steps: result.steps, avg_loss: avg_loss, W_U_lm: result.W, receipt: receipt }
}

fn full_lm_run_cached(shard_count, lr, epsilon, max_docs_per_shard, steps_per_doc) {
  let indices = list.range(0, shard_count) in
  let result = list.fold(indices, { W: lm.W_U_lm, history: [] }, fn(acc, idx) {
    let r = train_shard_cached(idx, acc.W, lr, epsilon, max_docs_per_shard, steps_per_doc) in
    { W: r.W_U_lm, history: list.append(acc.history, {
      shard: r.shard_index, steps: r.steps, avg_loss: r.avg_loss, receipt: r.receipt
    }) }
  }) in
  let final_receipt = hash.sha256_text(json.canonicalize({
    component: "azim_trial.lm_owt_train_cached",
    version: "2.0.0",
    shard_count: shard_count,
    history: result.history
  })) in
  { W_U_lm: result.W, history: result.history, final_receipt: final_receipt }
}

export { is_clean, precompute_hidden, train_doc_cached, train_shard_cached, full_lm_run_cached }
