import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("associative_scan") as scan

fn partition(inputs, parts) {
  let n = list.len(inputs) in
  let chunk_size = n / parts in
  list.chunk(inputs, chunk_size)
}

fn node_scan(inputs, state) {
  scan.sequential(inputs, state)
}

fn scan_chunks_with_state(chunks, initial_state) {
  let init = { state: initial_state, partials: [] } in
  let result = list.fold(chunks, init, fn(acc, chunk) {
    let next_state = node_scan(chunk, acc.state) in
    {
      state: next_state,
      partials: list.append(acc.partials, next_state)
    }
  }) in
  result
}

fn distributed_scan(inputs, state, parts) {
  let chunks = partition(inputs, parts) in
  let chained = scan_chunks_with_state(chunks, state) in
  let merged = chained.state in
  let sequential = scan.sequential(inputs, state) in
  {
    chunks: chunks,
    partials: chained.partials,
    merged: merged,
    equivalent: merged == sequential,
    node_count: parts
  }
}

fn scan_receipt(report) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.distributed_scan",
    version: "phase6.3",
    report: report
  }))
}

fn distributed_scan_with_receipt(inputs, state, parts) {
  let report = distributed_scan(inputs, state, parts) in
  let receipt = scan_receipt(report) in
  { report: report, receipt: receipt }
}

export {
  partition,
  node_scan,
  distributed_scan,
  scan_receipt,
  distributed_scan_with_receipt
}
