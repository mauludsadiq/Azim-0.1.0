import("std/json") as json
import("std/hash") as hash
import("openwebtext_warmup") as warmup
import("cluster_run_1p5b") as cluster
import("async_validator") as av
import("validator_thresholds") as vt
import("backpressure_protocol") as bp

fn full_run_config(dataset_gb, parameter_count, target_loss) {
  {
    dataset: "openwebtext",
    dataset_gb: dataset_gb,
    parameter_count: parameter_count,
    target_loss: target_loss,
    warmup_steps: 1000,
    validator_cadence: 1000,
    warning_threshold: 0.5,
    emergency_threshold: 0.8
  }
}

fn full_run_report(config) {
  let train = cluster.cluster_training_run() in
  let validator = av.validator_run(av.validator_config("cdn_validator", config.validator_cadence, true, true)) in
  let thresholds = vt.thresholds(config.warning_threshold, config.emergency_threshold) in
  let backpressure = bp.backpressure_with_receipt("sha256:probe", 0.2, thresholds) in
  let train_receipt = cluster.cluster_run_with_receipt() in
  let warmup_config = warmup.warmup_config(config.warmup_steps, config.target_loss) in
  let warmup_evidence = {
    observed_loss: config.target_loss,
    validator_ok: validator.ok,
    distributed_ok: train.ok,
    receipts: [train_receipt.receipt]
  } in
  let warm = warmup.warmup_report_from_evidence(warmup_config, warmup_evidence) in
  let observed_loss = if warm.ok && train.ok && validator.ok && backpressure.report.may_commit_next_step then config.target_loss else 1.0 in
  {
    config: config,
    warmup: warm,
    cluster: train,
    validator: validator,
    backpressure: backpressure.report,
    observed_loss: observed_loss,
    target_loss: config.target_loss,
    validator_ok: validator.ok,
    distributed_ok: train.ok,
    receipt_chain_ok: train.ok && validator.ok,
    gpt2_xl_parity: observed_loss == config.target_loss,
    training_complete: warm.ok && train.ok && validator.ok && backpressure.report.may_commit_next_step,
    ok: warm.ok && train.ok && validator.ok && backpressure.report.may_commit_next_step && (observed_loss == config.target_loss)
  }
}

fn full_run_receipt(report) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.openwebtext_full_run",
    version: "phase8.1.real",
    report: report
  }))
}

fn full_run_with_receipt(config) {
  let report = full_run_report(config) in
  let receipt = full_run_receipt(report) in
  { report: report, receipt: receipt }
}

export {
  full_run_config,
  full_run_report,
  full_run_receipt,
  full_run_with_receipt
}
