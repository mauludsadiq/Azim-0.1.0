import("std/json") as json
import("std/hash") as hash
import("std/list") as list
import("checkpoint") as ckpt
import("train_step") as train

fn run_one(checkpoint, example, lr) {
  let stepped = train.train_step_with_receipt(checkpoint.weight, example.text, example.label, lr) in
  let next_checkpoint = ckpt.advance(checkpoint, stepped.step.updated_W_U, stepped.receipt) in
  {
    checkpoint: next_checkpoint,
    event: {
      step: next_checkpoint.step,
      text: example.text,
      label: example.label,
      loss: stepped.step.loss_before,
      train_step_receipt: stepped.receipt,
      checkpoint_digest: ckpt.checkpoint_digest(next_checkpoint)
    }
  }
}

fn replay(examples, initial_checkpoint, lr) {
  let init = { checkpoint: initial_checkpoint, events: [] } in
  list.fold(examples, init, fn(state, example) {
    let one = run_one(state.checkpoint, example, lr) in
    {
      checkpoint: one.checkpoint,
      events: list.append(state.events, one.event)
    }
  })
}

fn replay_receipt(result) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.checkpoint_replay",
    version: "2.4.0",
    result: result
  }))
}

fn replay_with_receipt(examples, initial_checkpoint, lr) {
  let result = replay(examples, initial_checkpoint, lr) in
  let receipt = replay_receipt(result) in
  { result: result, receipt: receipt }
}

export { run_one, replay, replay_receipt, replay_with_receipt }
