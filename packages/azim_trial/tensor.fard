import("std/list") as list
import("std/rec") as rec
import("std/math") as math
import("std/float") as float
import("std/json") as json
import("std/hash") as hash
import("linalg_bridge") as lb

fn prod(xs) {
  list.fold(xs, 1, fn(acc, x) { acc * x })
}

fn valid_shape(dims, data) {
  prod(dims) == list.len(data)
}

fn tensor(dims, data) {
  { dims: dims, data: data, valid: valid_shape(dims, data) }
}

fn len(t) {
  list.len(t.data)
}

fn shape(t) {
  t.dims
}

fn zeros(n) {
  list.repeat(0.0, n)
}

fn vector(xs) {
  tensor([list.len(xs)], xs)
}

fn matrix(rows, cols, xs) {
  tensor([rows, cols], xs)
}

fn same_shape(a, b) {
  (list.len(a.dims) == list.len(b.dims)) && (prod(a.dims) == prod(b.dims))
}

fn matvec_compatible(m, v) {
  (list.len(m.dims) == 2) && (list.len(v.dims) == 1) && (list.get(m.dims, 1) == list.get(v.dims, 0))
}

fn matmul_compatible(a, b) {
  (list.len(a.dims) == 2) && (list.len(b.dims) == 2) && (list.get(a.dims, 1) == list.get(b.dims, 0))
}

fn get1(v, i) {
  list.get(v.data, i)
}

fn get2(m, r, c) {
  let cols = list.get(m.dims, 1) in
  list.get(m.data, r * cols + c)
}

fn set1(v, i, value) {
  tensor(v.dims, list.set(v.data, i, value))
}

fn map(v, f) {
  tensor(v.dims, list.map(v.data, f))
}

fn zip_with(a, b, f) {
  tensor(a.dims, list.zip_with(a.data, b.data, f))
}

fn add(a, b) {
  tensor(a.dims, list.zip_with(a.data, b.data, fn(x, y) { x + y }))
}

fn sub(a, b) {
  tensor(a.dims, list.zip_with(a.data, b.data, fn(x, y) { x - y }))
}

fn scale(a, s) {
  tensor(a.dims, list.map(a.data, fn(x) { x * s }))
}

fn dot(a, b) {
  lb.fast_dot(a.data, b.data)
}

fn row(m, r) {
  let cols = list.get(m.dims, 1) in
  vector(list.build(cols, fn(c) { get2(m, r, c) }))
}

fn col(m, c) {
  let rows = list.get(m.dims, 0) in
  vector(list.build(rows, fn(r) { get2(m, r, c) }))
}

fn matvec(m, v) {
  let rows = list.get(m.dims, 0) in
  let cols = list.get(m.dims, 1) in
  vector(lb.fast_matvec(m.data, rows, cols, v.data))
}

fn matmul(a, b) {
  let ar = list.get(a.dims, 0) in
  let ac = list.get(a.dims, 1) in
  let bc = list.get(b.dims, 1) in
  matrix(ar, bc, list.build(ar * bc, fn(i) {
    let r = float.to_int((i + 0.0) / (bc + 0.0)) in
    let c = i % bc in
    lb.fast_dot(list.build(ac, fn(k) { get2(a, r, k) }),
                list.build(ac, fn(k) { get2(b, k, c) }))
  }))
}

fn relu(v) {
  map(v, fn(x) { if x < 0.0 then 0.0 else x })
}

fn silu_scalar(x) {
  x / (1.0 + math.exp(0.0 - x))
}

fn silu(v) {
  map(v, fn(x) { silu_scalar(x) })
}

fn rms_norm(v, eps) {
  let n = list.len(v.data) in
  let ss = list.fold(v.data, 0.0, fn(acc, x) { acc + x * x }) in
  let mean = ss / (n + 0.0) in
  let denom = math.sqrt(mean + eps) in
  map(v, fn(x) { x / denom })
}

fn softmax(v) {
  let maxv = list.fold(v.data, list.get(v.data, 0), fn(acc, x) { if x > acc then x else acc }) in
  let exps = list.map(v.data, fn(x) { math.exp(x - maxv) }) in
  let total = list.fold(exps, 0.0, fn(acc, x) { acc + x }) in
  vector(list.map(exps, fn(x) { x / total }))
}

fn argmax(xs) {
  let init = { max_val: list.get(xs, 0), max_idx: 0 } in
  let result = list.fold(list.range(0, list.len(xs)), init, fn(acc, i) {
    let v = list.get(xs, i) in
    if v > acc.max_val then { max_val: v, max_idx: i } else acc
  }) in
  result.max_idx
}

fn digest(t) {
  hash.sha256_text(json.canonicalize(t))
}

export { prod, valid_shape, same_shape, matvec_compatible, matmul_compatible, tensor, len, shape, zeros, vector, matrix, get1, get2, set1, map, zip_with, add, sub, scale, dot, row, col, matvec, matmul, relu, silu_scalar, silu, rms_norm, softmax, argmax, digest }
