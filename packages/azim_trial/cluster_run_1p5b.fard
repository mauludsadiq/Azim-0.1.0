import("std/json") as json
import("std/hash") as hash
import("state_pack_cluster") as cluster
import("distributed_determinism") as dd
import("distributed_scan") as ds
import("rssm") as rssm
import("tensor") as tensor

fn training_batch() {
  [
    tensor.vector([1.0, 0.0, 0.0]),
    tensor.vector([0.0, 1.0, 0.0]),
    tensor.vector([0.0, 0.0, 1.0])
  ]
}

fn cluster_training_run() {
  let config = cluster.starter_cluster() in
  let state = rssm.init_state(3) in
  let batch = training_batch() in

  let scan = ds.distributed_scan(batch, state, 3) in

  let updates = [
    dd.node_update("node-1", { step: 0 }, { step: 1 }, { value: 1 }, { value: 1 }),
    dd.node_update("node-2", { step: 0 }, { step: 1 }, { value: 2 }, { value: 2 }),
    dd.node_update("node-3", { step: 0 }, { step: 1 }, { value: 3 }, { value: 3 })
  ] in

  let det = dd.determinism_report(updates) in

  {
    config: config,
    scan: scan,
    determinism: det,
    total_params: config.total_params,
    node_count: config.node_count,
    equivalent_scan: scan.equivalent,
    deterministic_updates: det.ok,
    ok: scan.equivalent && det.ok
  }
}

fn cluster_run_receipt(report) {
  hash.sha256_text(json.canonicalize({
    component: "azim_trial.cluster_run_1p5b",
    version: "phase6.3",
    report: report
  }))
}

fn cluster_run_with_receipt() {
  let report = cluster_training_run() in
  let receipt = cluster_run_receipt(report) in
  { report: report, receipt: receipt }
}

export {
  training_batch,
  cluster_training_run,
  cluster_run_receipt,
  cluster_run_with_receipt
}
