  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_humaneval.jsonl",
  tasks: [
    "Write a python function is_sorted(lst) that returns True if list is sorted",
    "Write a python function chunk(lst, n) that splits a list into chunks of size n",
    "Write a python function flatten_deep(lst) that recursively flattens a nested list",
    "Write a python function rotate(lst, k) that rotates a list k positions to the right",
    "Write a python function most_frequent(lst) that returns the most frequent element",
    "Write a python function running_sum(lst) that returns the running sum of a list",
    "Write a python function zip_with(f, lst1, lst2) that applies f pairwise",
    "Write a python function group_by(f, lst) that groups list elements by f(x)",
    "Write a python function take_while(pred, lst) that returns elements while pred is true",
    "Write a python function drop_while(pred, lst) that drops elements while pred is true",
    "Write a python function median(lst) that returns the median of a list",
    "Write a python function mode(lst) that returns the mode of a list",
    "Write a python function transpose(matrix) that transposes a 2D list",
    "Write a python function dot_product(v1, v2) that returns the dot product of two vectors",
    "Write a python function normalize(lst) that normalizes a list to sum to 1.0"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
