import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_loop_v2_r22",
  candidate_dir: "out/hybrid_loop_v2_r22/candidates",
  run_dir: "out/hybrid_loop_v2_r22/runs",
  accepted_out: "out/hybrid_loop_v2_r22/accepted",
  merged_out: "out/hybrid_loop_v2_r22/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function network_request(url) that makes a GET request and returns response",
    "Write a python function download_file(url, path) that downloads a file to disk",
    "Write a python function parse_args(argv) that parses command line arguments",
    "Write a python function run_command(cmd) that runs a shell command and returns output",
    "Write a python function env_get(key, default) that gets environment variable with default",
    "Write a python function load_config(path) that loads a YAML or JSON config file",
    "Write a python function save_config(path, config) that saves config to YAML or JSON",
    "Write a python function validate_schema(data, schema) that validates data against schema",
    "Write a python function format_table(rows, headers) that formats data as ASCII table",
    "Write a python function progress_bar(current, total, width) that renders a progress bar",
    "Write a python function color_text(text, color) that returns ANSI colored text",
    "Write a python function truncate_middle(s, n) that truncates middle of string with ellipsis",
    "Write a python function human_size(bytes) that formats bytes as human readable size",
    "Write a python function human_duration(seconds) that formats seconds as human readable duration",
    "Write a python function parse_duration(s) that parses duration string like 1h30m to seconds",
    "Write a python function fuzzy_match(query, choices) that returns best matching choice",
    "Write a python function diff_dicts(a, b) that returns added removed and changed keys",
    "Write a python function deep_equal(a, b) that checks deep equality of two objects",
    "Write a python function json_path(obj, path) that gets nested value by dot path",
    "Write a python function flatten_list(lst) that completely flattens arbitrarily nested list"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
