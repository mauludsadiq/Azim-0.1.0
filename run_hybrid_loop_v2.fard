import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_loop_v2_r14",
  candidate_dir: "out/hybrid_loop_v2_r14/candidates",
  run_dir: "out/hybrid_loop_v2_r14/runs",
  accepted_out: "out/hybrid_loop_v2_r14/accepted",
  merged_out: "out/hybrid_loop_v2_r14/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function serialize_tree(root) that serializes a binary tree to string",
    "Write a python function deserialize_tree(s) that deserializes a string to binary tree",
    "Write a python function lowest_common_ancestor(root, p, q) that finds LCA in BST",
    "Write a python function kth_smallest_bst(root, k) that finds kth smallest in BST",
    "Write a python function validate_bst(root) that validates a binary search tree",
    "Write a python function right_side_view(root) that returns right side view of tree",
    "Write a python function zigzag_traversal(root) that does zigzag level order traversal",
    "Write a python function path_sum(root, target) that finds all root-to-leaf paths summing to target",
    "Write a python function max_path_sum(root) that finds maximum path sum in binary tree",
    "Write a python function diameter(root) that finds diameter of a binary tree",
    "Write a python function count_nodes(root) that counts nodes in a complete binary tree",
    "Write a python function flatten_tree(root) that flattens binary tree to linked list",
    "Write a python function connect_next_pointers(root) that connects next right pointers",
    "Write a python function recover_bst(root) that recovers a BST with two swapped nodes",
    "Write a python function number_of_islands(grid) that counts islands using BFS",
    "Write a python function pacific_atlantic(grid) that finds cells reaching both oceans",
    "Write a python function word_ladder(begin, end, word_list) that finds shortest transformation",
    "Write a python function alien_dictionary(words) that finds character order in alien language",
    "Write a python function course_schedule(n, prerequisites) that checks if courses can be finished",
    "Write a python function reconstruct_itinerary(tickets) that reconstructs travel itinerary"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
