  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function max_profit(prices) that finds max profit from stock prices",
    "Write a python function max_profit_cooldown(prices) that includes cooldown period",
    "Write a python function buy_sell_infinite(prices) that allows infinite transactions",
    "Write a python function max_profit_k(k, prices) that allows at most k transactions",
    "Write a python function paint_house(costs) that finds minimum cost to paint houses",
    "Write a python function rob_houses(nums) that maximizes robbery without adjacent houses",
    "Write a python function rob_circular(nums) that maximizes robbery in circular arrangement",
    "Write a python function decode_ways(s) that counts ways to decode a digit string",
    "Write a python function wildcard_match(s, p) that matches with ? and * wildcards",
    "Write a python function regex_match(s, p) that matches with . and * regex",
    "Write a python function scramble_string(s1, s2) that checks if s2 is scrambled s1",
    "Write a python function interleaving_string(s1, s2, s3) that checks if s3 interleaves s1 and s2",
    "Write a python function distinct_subsequences(s, t) that counts distinct subsequences",
    "Write a python function min_window_substring(s, t) that finds minimum window containing t",
    "Write a python function substring_with_concatenation(s, words) that finds all concatenated substrings",
    "Write a python function longest_substring_k_distinct(s, k) that finds longest substring with k distinct chars",
    "Write a python function minimum_window_subsequence(s, t) that finds minimum window subsequence",
    "Write a python function count_palindromic_substrings(s) that counts all palindromic substrings",
    "Write a python function palindrome_partitioning(s) that returns all palindrome partitions",
    "Write a python function word_search(board, word) that searches for word in grid"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
