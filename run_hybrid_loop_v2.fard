  base_shard_path: "out/full_corpus_with_humaneval.jsonl",
  tasks: [
    "Write a python function is_palindrome(s) that returns True if s is a palindrome",
    "Write a python function sum_list(lst) that returns the sum of a list",
    "Write a python function max_list(lst) that returns the max of a list",
    "Write a python function min_list(lst) that returns the min of a list",
    "Write a python function mean(lst) that returns the mean of a list",
    "Write a python function clamp(x, lo, hi) that clamps x between lo and hi",
    "Write a python function sign(x) that returns -1, 0, or 1",
    "Write a python function zip_lists(a, b) that zips two lists into pairs",
    "Write a python function head(lst) that returns the first element",
    "Write a python function tail(lst) that returns all but the first element",
    "Write a python function last(lst) that returns the last element",
    "Write a python function init(lst) that returns all but the last element",
    "Write a python function replicate(n, x) that returns a list of n copies of x",
    "Write a python function range_step(start, stop, step) that returns a range with step",
    "Write a python function product(lst) that returns the product of all elements",
    "Write a python function any_pred(pred, lst) that returns True if any element satisfies pred",
    "Write a python function all_pred(pred, lst) that returns True if all elements satisfy pred",
    "Write a python function count_if(pred, lst) that counts elements satisfying pred",
    "Write a python function partition(pred, lst) that splits list into passing and failing",
    "Write a python function interleave(a, b) that interleaves two lists"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
