import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_loop_v2_r4",
  candidate_dir: "out/hybrid_loop_v2_r4/candidates",
  run_dir: "out/hybrid_loop_v2_r4/runs",
  accepted_out: "out/hybrid_loop_v2_r4/accepted",
  merged_out: "out/hybrid_loop_v2_r4/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_humaneval.jsonl",
  tasks: [
    "Write a python function is_prime(n) that returns True if n is prime",
    "Write a python function binary_search(lst, target) that returns the index or -1",
    "Write a python function reverse_string(s) that returns the reversed string",
    "Write a python function sum_digits(n) that returns the sum of digits of n",
    "Write a python function gcd(a, b) that returns the greatest common divisor",
    "Write a python function is_anagram(s1, s2) that returns True if s1 and s2 are anagrams",
    "Write a python function fibonacci(n) that returns the nth fibonacci number",
    "Write a python function count_words(s) that returns the number of words in s",
    "Write a python function remove_duplicates(lst) that returns list with duplicates removed",
    "Write a python function capitalize_words(s) that capitalizes every word in s"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
