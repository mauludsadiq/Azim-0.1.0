import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_loop_v2_r23",
  candidate_dir: "out/hybrid_loop_v2_r23/candidates",
  run_dir: "out/hybrid_loop_v2_r23/runs",
  accepted_out: "out/hybrid_loop_v2_r23/accepted",
  merged_out: "out/hybrid_loop_v2_r23/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function tokenize_code(s) that tokenizes Python source into tokens",
    "Write a python function ast_depth(code) that returns the maximum depth of a Python AST",
    "Write a python function count_functions(code) that counts function definitions in Python code",
    "Write a python function extract_imports(code) that extracts all import statements",
    "Write a python function lint_simple(code) that checks for common Python style issues",
    "Write a python function format_json(obj) that pretty prints JSON with indentation",
    "Write a python function minify_json(s) that removes whitespace from JSON string",
    "Write a python function csv_to_json(csv_text) that converts CSV text to list of dicts",
    "Write a python function json_to_csv(records) that converts list of dicts to CSV text",
    "Write a python function xml_to_dict(xml_text) that parses simple XML to dict",
    "Write a python function markdown_to_text(md) that strips markdown formatting",
    "Write a python function extract_code_blocks(md) that extracts code blocks from markdown",
    "Write a python function count_tokens(text) that counts approximate GPT tokens in text",
    "Write a python function split_sentences(text) that splits text into sentences",
    "Write a python function normalize_unicode(text) that normalizes unicode to ASCII",
    "Write a python function detect_language(text) that detects if text is python js or fard",
    "Write a python function strip_comments(code, lang) that removes comments from code",
    "Write a python function indent_block(code, n) that re-indents a code block by n spaces",
    "Write a python function wrap_function(code, name) that wraps code in a function definition",
    "Write a python function generate_docstring(name, args) that generates a docstring template"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
