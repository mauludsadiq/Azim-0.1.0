import("std/list") as list
import("std/str") as str
import("packages/azim_code/corpus_acquire") as ca

let repos = [
  { owner: "TheAlgorithms", repo: "Python" },
  { owner: "TheAlgorithms", repo: "JavaScript" },
  { owner: "TheAlgorithms", repo: "Rust" },
  { owner: "keon", repo: "algorithms" },
  { owner: "nicowillis", repo: "rust-algorithms" },
  { owner: "EbTech", repo: "rust-algorithms" },
  { owner: "BurntSushi", repo: "walkdir" },
  { owner: "TheAlgorithms", repo: "TypeScript" },
  { owner: "nicowillis", repo: "javascript-algorithms" },
  { owner: "trekhleb", repo: "javascript-algorithms" }
]

let results = list.map(repos, fn(r) {
  ca.acquire_and_pack(r.owner, r.repo, 30,
    str.concat(["out/multilang_corpus/", r.repo]))
})

{
  repos: list.len(repos),
  total_accepted: list.fold(results, 0, fn(a, r) { a + r.accepted_count }),
  total_tokens: list.fold(results, 0, fn(a, r) { a + r.total_tokens }),
  results: list.map(list.range(0, list.len(results)), fn(i) {
    let r = list.get(results, i) in
    let repo = list.get(repos, i) in
    { repo: repo.repo, accepted: r.accepted_count, tokens: r.total_tokens }
  })
}
