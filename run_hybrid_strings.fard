import("std/fs") as fs
import("packages/azim_code/hybrid_loop_v2") as loop

loop.run_hybrid_loop_v2({
  out_root: "out/hybrid_strings_r2",
  candidate_dir: "out/hybrid_strings_r2/candidates",
  run_dir: "out/hybrid_strings_r2/runs",
  accepted_out: "out/hybrid_strings_r2/accepted",
  merged_out: "out/hybrid_strings_r2/merged",
  train_checkpoint_dir: "out/full_corpus_training",
  checkpoint_path: "out/full_corpus_training/code_checkpoint.json",
  base_shard_path: "out/full_corpus_with_hybrid.jsonl",
  tasks: [
    "Write a python function tokenize(s) that splits string into tokens respecting quotes",
    "Write a python function parse_kv(s) that parses key=value pairs from a string",
    "Write a python function camel_to_snake(s) that converts camelCase to snake_case",
    "Write a python function snake_to_camel(s) that converts snake_case to camelCase",
    "Write a python function truncate(s, n) that truncates string to n chars with ellipsis",
    "Write a python function wrap(s, width) that wraps text to given width",
    "Write a python function indent(s, n) that indents each line by n spaces",
    "Write a python function dedent(s) that removes common leading whitespace",
    "Write a python function slugify(s) that converts string to URL-friendly slug",
    "Write a python function extract_emails(s) that extracts all email addresses from string",
    "Write a python function extract_urls(s) that extracts all URLs from string",
    "Write a python function extract_numbers(s) that extracts all numbers from string",
    "Write a python function mask(s, char) that masks all but last 4 chars with char",
    "Write a python function pad_left(s, n, char) that left-pads string to length n",
    "Write a python function pad_right(s, n, char) that right-pads string to length n",
    "Write a python function remove_punctuation(s) that removes all punctuation",
    "Write a python function normalize_whitespace(s) that collapses multiple spaces",
    "Write a python function count_occurrences(s, sub) that counts non-overlapping occurrences",
    "Write a python function find_all(s, sub) that returns all indices of substring",
    "Write a python function template(s, vars) that substitutes {key} placeholders"
  ],
  langs: ["python"],
  api_url: "https://api.openai.com/v1/chat/completions",
  api_key: fs.read_text(".openai_key"),
  model: "gpt-4o-mini",
  max_azim_attempts: 1,
  max_llm_attempts: 3,
  azim_tokens: 64,
  azim_k: 4,
  azim_temp: 1.0,
  lr: 0.0005,
  epsilon: 0.0001,
  max_train_records: -1,
  steps_per_record: 10,
  min_accepted: 1,
  min_records: 1,
  require_loss_decrease: true
})
